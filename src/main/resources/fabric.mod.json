{
  "schemaVersion": 1,
  "id": "bettercontroller",
  "version": "${version}",
  "name": "BetterController",
  "description": "Client-side gamepad support for Minecraft Java. Analog look + movement, full GUI navigation, creative double-tap fly, virtual keyboard for chat.",
  "authors": [
    "Nekuzaky"
  ],
  "contact": {
    "homepage": "https://github.com/Nekuzaky/BetterController",
    "sources": "https://github.com/Nekuzaky/BetterController",
    "issues": "https://github.com/Nekuzaky/BetterController/issues"
  },
  "license": "MIT",
  "environment": "client",
  "entrypoints": {
    "client": [
      "com.bettercontroller.client.BetterControllerClientMod"
    ]
  },
  "mixins": [
    "bettercontroller.client.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.18.4",
    "fabric-api": "*",
    "minecraft": "~26.1",
    "java": ">=25"
  }
}
